{
  "name": "youtube-videos-maker",
  "private": true,
  "type": "commonjs",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "tsc -p tsconfig.base.json --noEmit && vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc -p tsconfig.base.json --noEmit",
    "doctor": "tsx packages/pipeline/src/cli.ts doctor",
    "check": "tsx packages/pipeline/src/cli.ts doctor",
    "pipeline:run": "tsx packages/pipeline/src/cli.ts run",
    "db:setup": "bash scripts/setup-env.sh",
    "ollama:setup": "bash scripts/setup-ollama.sh",
    "ollama:serve": "mkdir -p models/ollama && OLLAMA_MODELS=\"$(cd models/ollama && pwd -P)\" ./bin/ollama serve"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
