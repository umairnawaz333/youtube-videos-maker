# SQLite database location
# Prisma resolves this relative path against the schema's own directory
# (packages/db/prisma), not the repo root — hence three levels up to reach
# the repo-root storage/factory.db that cli.ts's default also points at.
DATABASE_URL="file:../../../storage/factory.db"
# Per-run asset root
STORAGE_ROOT="./storage"
# Keep every model download inside the repo
OLLAMA_MODELS="./models/ollama"
HF_HOME="./models/hf"
# Where the locally-served Ollama listens. The provider never starts a server itself;
# run `pnpm ollama:serve` in another terminal first.
OLLAMA_HOST="http://127.0.0.1:11434"
# Model tag used by the LLM stages. Must be present in `bin/ollama list`.
LLM_MODEL="qwen3:8b"
