# SQLite database location
# Prisma resolves this relative path against the schema's own directory
# (packages/db/prisma), not the repo root — hence three levels up to reach
# the repo-root storage/factory.db that cli.ts's default also points at.
DATABASE_URL="file:../../../storage/factory.db"
# Per-run asset root
STORAGE_ROOT="./storage"
# Keep every model download inside the repo. `pnpm ollama:setup` / `pnpm ollama:serve` resolve
# this to an absolute, symlink-resolved path anchored at the repo root before launching the
# server, so these relative defaults are only a reference — the running server never trusts
# a bare relative path that could silently repoint if the launch directory goes away.
OLLAMA_MODELS="./models/ollama"
HF_HOME="./models/hf"
# Where the locally-served Ollama listens. The provider never starts a server itself;
# run `pnpm ollama:serve` in another terminal first.
OLLAMA_HOST="http://127.0.0.1:11434"
# Model tag used by the LLM stages. Must be present in `bin/ollama list`.
LLM_MODEL="qwen3:8b"
# Where the locally-served imagegen sidecar listens. The provider never starts the sidecar
# itself; run `pnpm imagegen:serve` in another terminal first.
IMAGEGEN_HOST="http://127.0.0.1:8000"

# --- Publisher (stage 14): YouTube Data API v3 OAuth credentials ---------------------------
# Required only when config.upload is true and a run reaches the Publisher stage. All three
# are real secrets: never commit real values, only ever set them in a local, git-ignored .env.
#
# How to obtain them:
#   1. In Google Cloud Console (console.cloud.google.com), create or pick a project, then
#      enable the "YouTube Data API v3" (APIs & Services > Library).
#   2. APIs & Services > OAuth consent screen: set it up as "External" and leave it in
#      "Testing" mode (publishing/verification is a separate, later step). Add the
#      `https://www.googleapis.com/auth/youtube.upload` scope, and add the channel owner's own
#      Google account under "Test users" — an app in Testing mode will only authenticate users
#      on that list.
#   3. APIs & Services > Credentials > Create Credentials > OAuth client ID. Choose
#      "Desktop app" as the application type (simplest for a one-time, local consent flow with
#      no public redirect URI to host). This gives you YOUTUBE_CLIENT_ID and
#      YOUTUBE_CLIENT_SECRET immediately.
#   4. YOUTUBE_REFRESH_TOKEN has to be obtained once via a real (human-in-the-browser) OAuth
#      consent flow — there is no way to generate it without that step, and nothing in this
#      repo performs it automatically. Google's OAuth 2.0 Playground
#      (developers.google.com/oauthplayground) is the fastest path: gear icon > "Use your own
#      OAuth credentials" > paste the client id/secret from step 3 > authorize the
#      `https://www.googleapis.com/auth/youtube.upload` scope, signed in as the same test user
#      from step 2 > "Exchange authorization code for tokens" > copy the resulting
#      "Refresh token" field. That token does not expire on its own; it stops working only if
#      revoked, if the OAuth client is deleted, or after 7 days of total inactivity for an app
#      still in Testing mode (re-run this step if a refresh ever fails with `invalid_grant`).
#
# Two consequences of staying in "Testing" mode (the default, and fine for personal use) that
# the Publisher stage surfaces at runtime rather than only here: every upload is forced to
# private by YouTube regardless of the privacy status requested, and an unaudited project's
# quota (10,000 units/day, ~1,600 units per upload) caps throughput at roughly six uploads/day.
YOUTUBE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
YOUTUBE_CLIENT_SECRET="your-client-secret"
YOUTUBE_REFRESH_TOKEN="your-refresh-token"
